# Read by vite.config.ts on the camera laptop only — never sent to the phone.

# The apps/ai service running next to the camera.
AI_SERVICE_URL=http://localhost:8001
# Must match BACKEND_API_KEY in apps/ai/.env
AI_SERVICE_API_KEY=dev-ai-pipeline-shared-secret-change-me

# The page listens on Supabase Realtime and sounds the siren while the mobile
# app's panic button is held. Same project as apps/native's
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY. These are public
# (bundled into the page), unlike the AI key above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
