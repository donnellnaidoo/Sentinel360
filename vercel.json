{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "services": {
    "web": {
      "root": "apps/web"
    },
    "api": {
      "root": "apps/server",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    { "source": "/trpc/(.*)", "destination": { "service": "api" } },
    { "source": "/internal/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
