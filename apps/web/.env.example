# Example environment variables for the web app
# Copy this to .env and fill in secret values before running locally

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL of the Python AI service (FastAPI on :8000 by default)
# This is used by Next.js rewrites to proxy /api/* requests
AI_SERVICE_URL=http://localhost:8000

# Do not commit your real .env file with secrets to version control.