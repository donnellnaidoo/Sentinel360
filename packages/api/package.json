    "@Sentinel360/env": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "drizzle-orm": "^0.45.1",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Sentinel360/config": "workspace:*",
    "@vitest/ui": "4.1.8",
    "hono": "catalog:",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
