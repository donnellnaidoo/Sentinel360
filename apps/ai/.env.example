# Full list and defaults: app/config.py

# x3tcp://127.0.0.1:5001 (Insta360 X3 via Sentinel360X3Stitcher.exe, Windows)
# rtsp://... or http://<phone-ip>:8081/video (network camera)
# samples/demo.mp4 (local file, looped)
STREAM_SOURCE=samples/demo.mp4
STREAM_LOOP=true
CAMERA_ID=CAM-DEMO-1
TARGET_FPS=5

# Must match AI_SERVICE_API_KEY in apps/server/.env
BACKEND_URL=http://localhost:3000
BACKEND_API_KEY=dev-ai-pipeline-shared-secret-change-me

# SlowFast is EXPERIMENTAL (uncalibrated for X3) — false to switch it off.
ANOMALY_ENABLED=true
ANOMALY_DEVICE=auto
# auto = cuda > mps > cpu (MPS ~2x faster than CPU on Apple Silicon)
WEAPON_DEVICE=auto

# Every face in view when an event fires is attached to the case as
# evidence (detection only, no identity). Includes bystanders — see README.
FACE_ENABLED=true
# FACE_MAX_PER_EVENT=5

# Panic button (apps/panic): how long a press waits for the first frame if
# the pipeline has to start, and the window in which repeat presses join
# the same docket.
# PANIC_FRAME_WAIT_SECONDS=20
# PANIC_COOLDOWN_SECONDS=10
