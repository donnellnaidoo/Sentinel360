{
  "expo": {
    "scheme": "Sentinel360",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "Sentinel360",
    "slug": "Sentinel360",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1f22"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sentinel360 uses your location to show your area and attach it to reports."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sentinel360 uses your photos so you can set a profile picture and attach evidence to reports.",
          "cameraPermission": "Sentinel360 uses your camera so you can take a profile picture and capture report evidence."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f6e7334a-6b78-4792-bdba-83ad6fde7bdd"
      }
    },
    "owner": "serati-shai",
    "android": {
      "package": "com.seratishai.Sentinel360",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
